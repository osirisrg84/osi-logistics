# Server port (set automatically by Render/Railway)
PORT=3001

# Comma-separated list of allowed frontend origins
FRONTEND_URL=https://your-app.vercel.app

# SQLite database file path (use /var/data/osi_logistics.db on Render with disk)
DATABASE_PATH=./osi_logistics.db

# Node environment
NODE_ENV=production

# --- Database (Turso/libSQL) -------------------------------------------
# If unset, falls back to a local SQLite file (disposable, resets on deploy).
TURSO_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# --- Auth / admin bootstrap ----------------------------------------------
# Password for the seeded admin@osilogistics.com account (this IS the real
# production admin account, not a demo one).
ADMIN_PASSWORD=change-me
# Required by POST /api/auth/setup-admin — without this set, that endpoint
# always rejects (fail-closed). Keep this secret, never commit it.
ADMIN_SETUP_SECRET=
ADMIN_EMAIL=

# --- Anthropic (chat widget + internal assistant) -------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Resend (transactional emails). Optional — if unset, email sending is
# skipped with a console warning instead of crashing.
RESEND_API_KEY=re_...
RESEND_FROM=

# --- Welcome-email tutorial video links. Optional — the video section
# simply doesn't render in the email until these are set.
DRIVER_TUTORIAL_URL=
DISPATCHER_TUTORIAL_URL=

# --- Web Push (VAPID). Optional — push notifications are disabled with a
# console error until both are set. Generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Firebase Admin (phone verification). Optional — only needed for the
# /api/auth/confirm-phone-verified flow. Paste the full service-account JSON
# as a single-line string.
FIREBASE_SERVICE_ACCOUNT=

# --- Twilio-alternative SMS (TextBelt). Optional.
TEXTBELT_KEY=

# --- Stripe (driver commission card payments) -----------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
# Required for /api/stripe/webhook to accept events — without it, the
# webhook rejects everything (fail-closed) rather than trusting unsigned input.
STRIPE_WEBHOOK_SECRET=whsec_...

# Set automatically by Render; used to build absolute URLs where needed.
RENDER_EXTERNAL_URL=
